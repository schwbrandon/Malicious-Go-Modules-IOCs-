# ================================
# KQL Threat Hunting Queries
# ================================

# 1. Hunt for Known Malicious Domains (Go Modules / Payload Fetching)
DeviceNetworkEvents
| where RemoteUrl has_any (
    "github.com/truthfulpharm/prototransform",
    "github.com/blankloggia/go-mcp",
    "github.com/steelpoor/tlsproxy",
    "smtp.gmail.com", "github.com", "web3x", "herewalletbot"
)
| project Timestamp, DeviceName, InitiatingProcessFileName, RemoteUrl, InitiatingProcessCommandLine

# 2. Look for Destructive Disk Overwrite Behavior (Linux dd or shred commands)
DeviceProcessEvents
| where OSPlatform == "Linux"
| where ProcessCommandLine has_any ("dd if=", "shred", "/dev/sda", "of=/dev/sda")
| project Timestamp, DeviceName, InitiatingProcessFileName, ProcessCommandLine

# 3. Suspicious Use of wget or curl to Fetch Payloads
DeviceProcessEvents
| where ProcessCommandLine has_any ("wget", "curl")
| where ProcessCommandLine has_any ("http", "https")
| project Timestamp, DeviceName, FileName, ProcessCommandLine, InitiatingProcessFileName

# 4. Identify Suspicious SMTP Traffic (Gmail-Based Exfiltration)
DeviceNetworkEvents
| where RemoteUrl has "smtp.gmail.com"
| where RemotePort == 587 or RemotePort == 465
| project Timestamp, DeviceName, RemoteUrl, InitiatingProcessFileName, InitiatingProcessCommandLine

# 5. WebSocket Usage From CLI Tools or Scripts
DeviceNetworkEvents
| where InitiatingProcessCommandLine has "websocket"
or RemoteUrl endswith ".websocket"
| project Timestamp, DeviceName, RemoteUrl, InitiatingProcessCommandLine
